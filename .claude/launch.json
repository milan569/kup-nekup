{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "web",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "web-export",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "app/dist-web",
        "-l",
        "3000",
        "--no-clipboard"
      ],
      "port": 3000
    }
  ]
}
