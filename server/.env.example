# Zkopírujte do server/.env a doplňte. Soubor .env se nikdy necommituje.
ANTHROPIC_API_KEY=sk-ant-...

# Model pro čtení etiket a ruční zadání. Výchozí: claude-opus-5-5.
CLAUDE_MODEL=claude-opus-5-5

# Posudek AI s webovým průzkumem (historie značky, receptury, kauzy).
# Výchozí: stejný model jako výše. Levnější varianta: claude-sonnet-5-5.
INSIGHT_MODEL=claude-opus-5-5
# low | medium | high – hloubka uvažování; vyšší = pomalejší a dražší
INSIGHT_EFFORT=medium
# kolik webových vyhledávání smí jeden posudek použít
INSIGHT_MAX_SEARCHES=6

# Přístupový klíč aplikace. Na serveru online VŽDY nastavte (dlouhý náhodný řetězec)
# a stejný zadejte v aplikaci: Profil → Nastavení serveru → Přístupový klíč.
# Prázdné = bez ochrany, jen pro domácí síť.
APP_TOKEN=

# Ochrana kreditu: max. počet dotazů na AI za hodinu z jedné adresy
AI_RATE_PER_HOUR=60

# Port serveru
PORT=8787

# Cesta k SQLite cache
DB_PATH=./data/cache.sqlite
