# Zkopírujte do app/.env. Adresa serveru, na kterou se aplikace připojuje.
# Při vývoji sem dejte IP adresu vašeho počítače v místní síti (ne localhost):
# telefon s Expo Go musí být na stejné Wi-Fi jako počítač se serverem.
# IP zjistíte příkazem `ipconfig` (Windows) – řádek IPv4 Address.
# Adresu lze později změnit i přímo v aplikaci: Profil → Nastavení serveru.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8787

# Přístupový klíč pro online server (posílá se jako hlavička x-app-token).
# Pro server na vlastním počítači nechte prázdné. Lze změnit i v aplikaci.
EXPO_PUBLIC_APP_TOKEN=
